# LLM API keys for the dynamic modules service.
# Set OPENROUTER_API_KEY for OpenRouter or ZEN_API_KEY for OpenCode Zen (nemotron-3-ultra-free).
OPENROUTER_API_KEY=
ZEN_API_KEY=

# Runtime safety (local defaults only; production must use Firebase or a
# service-to-service bearer token and explicit HTTPS origins).
APP_ENV=development
VV_AUTH_MODE=off
VV_API_TOKEN=
CORS_ORIGINS=http://127.0.0.1,http://localhost
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SEC=12
MAX_PROCESSES_JSON_BYTES=16384
LLM_PROVIDER=zen
LLM_MODEL=nemotron-3-ultra-free
LLM_TIMEOUT_SEC=90

# Dedicated phoneme env vars (see phoneme_service/.env.example)
HF_TOKEN=
VV_FP16=1
PHONEME_PRELOAD=1

# Centralized cache directories (optional; automatically routes all runtime caches to .cache/)
PYTHONPYCACHEPREFIX=.cache/pycache
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
