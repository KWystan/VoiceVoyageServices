# OpenCode Zen API key for the dynamic modules service (LLM).
# Copy this file to .env and fill in your key — .env is gitignored.
ZEN_API_KEY=

# Centralized cache directories (optional; automatically routes all runtime caches to .cache/)
PYTHONPYCACHEPREFIX=.cache/pycache
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
