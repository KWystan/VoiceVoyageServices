# LLM API keys for the dynamic modules service.
# Set OPENROUTER_API_KEY for OpenRouter (Nemotron-3 Ultra / Gemma) or ZEN_API_KEY for OpenCode Zen.
OPENROUTER_API_KEY=
ZEN_API_KEY=

# Dedicated phoneme env vars (see phoneme_service/.env.example)
HF_TOKEN=
VV_FP16=1
PHONEME_PRELOAD=1

# Centralized cache directories (optional; automatically routes all runtime caches to .cache/)
PYTHONPYCACHEPREFIX=.cache/pycache
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
