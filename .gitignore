# ---------------------------------------------------------------------------
# Voice Voyage Services — monorepo .gitignore
# Only files that are PART OF THE FLOW are tracked.  Everything below is
# regenerable, reference-only, or tooling.
# ---------------------------------------------------------------------------

# ---- Secrets (NEVER commit) ----
.env
*.env
!*.env.example

# ---- Python runtime artifacts ----
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
*.pyo

# ---- IDE / editor ----
.vscode/
.idea/

# ---- Agent tooling (not app code) ----
.agents/

# ---- Old versions / reference only (do not ship) ----
archive/

# ---- Dev scripts (not part of the flow) ----
scripts/*
!scripts/
!scripts/sync_word_bank_catalog.py
tools/

# ---- Test suite (kept local by request; not shipped) ----
tests/

# ---- Simulation records & runs (local only) ----
records/

# ---- Temp / junk & logs ----
main.py.tmp
*.tmp
*.log

# ---- OS noise ----
Thumbs.db
.DS_Store

# ---- VS Code Code Runner temp files ----
tempCodeRunnerFile.py
