# ---------------------------------------------------------------------------
# Voice Voyage Services — monorepo .gitignore
# Only files that are PART OF THE FLOW are tracked.  Everything below is
# regenerable, reference-only, or tooling.
# ---------------------------------------------------------------------------

# ---- Secrets (NEVER commit) ----
.env
*.env
!*.env.example

# ---- Python runtime artifacts ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
*.pyo

# ---- IDE / editor ----
.vscode/
.idea/

# ---- Agent tooling (not app code) ----
.agents/

# ---- Old versions / reference only (do not ship) ----
archive/

# ---- Dev scripts (not part of the flow) ----
scripts/

# ---- Test suite (kept local by request; not shipped) ----
tests/

# ---- Simulation records & runs (local only) ----
records/

# ---- Design docs & generated data dumps (regenerable, not runtime) ----
docs/

# ---- Large local model artifacts ----
models/

# ---- Temp / junk ----
main.py.tmp
*.tmp

# ---- Package marker files (untracked by request) ----
# WARNING: a fresh clone is missing __init__.py by design; all imports are
# submodule-style so the services still boot (namespace packages).
__init__.py

# ---- OS noise ----
Thumbs.db
.DS_Store

# ---- VS Code Code Runner temp files ----
tempCodeRunnerFile.py
