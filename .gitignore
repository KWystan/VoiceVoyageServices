# ---------------------------------------------------------------------------
# Voice Voyage — FinalPhonemeRecognizer .gitignore
# Only files that are PART OF THE FLOW are tracked.  Everything below is
# regenerable, reference-only, or tooling — safe to delete, never required
# by the /assess pipeline or the test suite.
# ---------------------------------------------------------------------------

# ---- Python runtime artifacts ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
*.pyo

# ---- IDE / editor ----
.vscode/
.idea/

# ---- Agent tooling (not app code) ----
.agents/

# ---- Old versions / reference only (do not ship) ----
archive/

# ---- Dev scripts (not part of the /assess flow) ----
scripts/

# ---- Test suite (kept local by request; not shipped) ----
tests/

# ---- Simulation records & runs (local only, not part of the flow) ----
records/

# ---- Design docs & generated data dumps (regenerable, not runtime) ----
docs/

# ---- Large local model artifacts ----
models/

# ---- Temp / junk ----
main.py.tmp
*.tmp

# ---- Package marker files (untracked by request) ----
# WARNING: phoneme_processes/__init__.py defines ProcessDetector and
# util/__init__.py re-exports the util API — a FRESH CLONE will fail to
# start without them (Docker/HF Spaces).  Re-track with:
#   git add -f __init__.py  (per package)
__init__.py

# ---- OS noise ----
Thumbs.db
.DS_Store

tests/