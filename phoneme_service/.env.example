# Phoneme service — copy to .env (gitignored) or set in Railway Variables
# Dedicated HF token (high rate-limits + faster 1.4GB wav2vec2 download)
HF_TOKEN=

# Runtime safety.
# APP_ENV=development
# VV_AUTH_MODE=off
# VV_API_TOKEN=
# CORS_ORIGINS=http://127.0.0.1,http://localhost
# MAX_AUDIO_UPLOAD_BYTES=10485760
# MAX_AUDIO_DURATION_SEC=12

# 1 = float16 ~600MB peak (free tier), 0 = float32 + INT8 ~1.2GB peak
VV_FP16=1

# 1 = preload Wav2Vec2 in background (ready in ~40s), 0 = lazy on first /assess (saves RAM idle)
PHONEME_PRELOAD=1

# Cache dirs (auto-routed to .cache/, respect .dockerignore)
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
PYTHONPYCACHEPREFIX=.cache/pycache
